{
  "name": "svg2woff2",
  "version": "0.3.5",
  "description": "generate woff2 font from svg files",
  "main": "dist/svg2woff2.js",
  "types": "dist/svg2woff2.d.ts",
  "author": {
    "name": "osawa naotaka"
  },
  "license": "MIT",
  "homepage": "https://github.com/osawa-naotaka/svg2woff2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osawa-naotaka/svg2woff2.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx ./app/app.ts",
    "analyze": "tsx ./app/analyze.ts",
    "watch": "tsx watch ./app/app.ts",
    "build": "tsc && tsdown --config tsdown.config.ts",
    "check": "biome check ./src ./types ./app",
    "check-write": "biome check --write ./src ./types ./app"
  },
  "packageManager": "yarn@4.8.0",
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@types/node": "^24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/svg2ttf": "^5.0.3",
    "opentype.js": "^1.3.5",
    "tsdown": "^0.22.7",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lulliecat/svg2ttf": "^6.0.7",
    "element-to-path": "^1.2.1",
    "svg-path-commander": "^2.2.1",
    "svgson": "^5.3.1",
    "ttf2woff2": "^8.0.1"
  }
}
